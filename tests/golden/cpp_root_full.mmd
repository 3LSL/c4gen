C4Component
    title Component diagram for the repository root

    Boundary(b_root, "(repository root)", "module") {
        Boundary(b_include, "include", "module") {
            Boundary(b_include_app, "app", "module") {
                Component(f_include_app_repo_h, "repo.h", "C++")
            }
        }
        Boundary(b_src, "src", "module") {
            Component(f_src_all_h, "all.h", "C/C++")
            Component(f_src_main_cpp, "main.cpp", "C++")
            Component(f_src_session_h, "session.h", "C++")
            Component(f_src_token_h, "token.h", "C/C++")
        }
    }

    System_Ext(x_operator, "operator")
    System_Ext(x_sessions_db, "sessions-db")

    Rel(f_include_app_repo_h, x_sessions_db, "Reads and writes session rows")
    Rel(f_src_main_cpp, f_src_session_h, "Starts a login session")
    Rel(f_src_session_h, f_include_app_repo_h, "Stores and retrieves session records")
    Rel(f_src_session_h, f_src_token_h, "")
    Rel(x_operator, f_src_main_cpp, "Starts the application from a terminal")
